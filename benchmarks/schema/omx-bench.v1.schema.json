{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmixer.org/benchmarks/omx-bench.v1.schema.json",
  "title": "omx-bench/1",
  "description": "One benchmark run: the same scenarios measured on up to four plugin hosts on one machine. Values are measured, never typed; a scenario a host cannot run is status unsupported with the reason in note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "machine",
    "software",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "omx-bench/1"
    },
    "id": {
      "type": "string",
      "pattern": "^(rpi5|desk|ci)-[0-9]{8}-[0-9]+$"
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "model",
        "os"
      ],
      "properties": {
        "class": {
          "enum": [
            "rpi5",
            "desk",
            "ci"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string"
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "ram_mb": {
          "type": "integer",
          "minimum": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string"
        },
        "governor": {
          "type": "string"
        }
      }
    },
    "software": {
      "type": "object",
      "description": "Version strings of what was measured; a program not present in the run has no entry.",
      "additionalProperties": false,
      "properties": {
        "plugin-hostd": {
          "type": "string"
        },
        "omx-clap-host": {
          "type": "string"
        },
        "mod-host": {
          "type": "string"
        },
        "jalv": {
          "type": "string"
        },
        "jack": {
          "type": "string"
        },
        "omx-clap-core": {
          "type": "string"
        },
        "omx-plugins-clap": {
          "type": "string"
        },
        "omx-plugins-lv2": {
          "type": "string"
        },
        "calf-plugins": {
          "type": "string"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set"
      ],
      "properties": {
        "set": {
          "type": "string",
          "minLength": 1
        },
        "jalv": {
          "type": "integer",
          "minimum": 0
        },
        "mod-host": {
          "type": "integer",
          "minimum": 0
        },
        "omx-clap-lv2": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugins"
      ],
      "properties": {
        "plugins": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        },
        "rates": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "quanta": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "suitable": {
          "type": "integer",
          "minimum": 0
        },
        "unsuitable": {
          "type": "integer",
          "minimum": 0
        },
        "lv2": {
          "type": "integer",
          "minimum": 0
        },
        "clap": {
          "type": "integer",
          "minimum": 0
        },
        "qualified_in_process": {
          "type": "integer",
          "minimum": 0
        },
        "qualified_isolated": {
          "type": "integer",
          "minimum": 0
        },
        "crashed": {
          "type": "integer",
          "minimum": 0
        },
        "hung": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "unmeasured": {
          "type": "integer",
          "minimum": 0
        },
        "no_pin": {
          "type": "integer",
          "minimum": 0
        },
        "packages_installed": {
          "type": "integer",
          "minimum": 0
        },
        "packages_verified": {
          "type": "integer",
          "minimum": 0
        },
        "records_package": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Where the figures of the run were read from."
    },
    "add_times": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cold": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "set",
              "host",
              "mode",
              "plugins",
              "median_ms",
              "min_ms",
              "max_ms",
              "repeats"
            ],
            "properties": {
              "set": {
                "type": "string"
              },
              "builds": {
                "type": "string"
              },
              "host": {
                "enum": [
                  "H1",
                  "H2",
                  "H3",
                  "H4"
                ]
              },
              "mode": {
                "$ref": "#/$defs/mode"
              },
              "plugins": {
                "type": "integer",
                "minimum": 1
              },
              "median_ms": {
                "type": "number",
                "minimum": 0
              },
              "min_ms": {
                "type": "number",
                "minimum": 0
              },
              "max_ms": {
                "type": "number",
                "minimum": 0
              },
              "repeats": {
                "type": "integer",
                "minimum": 1
              },
              "start_to_answering_ms": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "warm": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "mode",
              "plugins",
              "median_ms",
              "min_ms",
              "max_ms",
              "repeats"
            ],
            "properties": {
              "builds": {
                "type": "string"
              },
              "host": {
                "enum": [
                  "H1",
                  "H2",
                  "H3",
                  "H4"
                ]
              },
              "mode": {
                "$ref": "#/$defs/mode"
              },
              "plugins": {
                "type": "integer",
                "minimum": 1
              },
              "median_ms": {
                "type": "number",
                "minimum": 0
              },
              "min_ms": {
                "type": "number",
                "minimum": 0
              },
              "max_ms": {
                "type": "number",
                "minimum": 0
              },
              "repeats": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "host",
          "notes",
          "repeats",
          "dsp_load_avg",
          "xruns",
          "spread",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "enum": [
              "H2",
              "H3",
              "standalone"
            ]
          },
          "notes": {
            "type": "integer",
            "minimum": 1
          },
          "repeats": {
            "type": "integer",
            "minimum": 1
          },
          "dsp_load_avg": {
            "type": "number",
            "minimum": 0
          },
          "pss_mb": {
            "type": "number",
            "minimum": 0
          },
          "peak_db": {
            "type": "number"
          },
          "xruns": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "ok",
              "failed"
            ]
          },
          "spread": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "xruns"
            ],
            "properties": {
              "dsp_load_avg": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "pss_mb": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "xruns": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_thread_shares"
      ],
      "properties": {
        "audio_thread_shares": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "where",
              "cvp24_lv2",
              "cvp24"
            ],
            "properties": {
              "where": {
                "type": "string"
              },
              "cvp24_lv2": {
                "type": "string"
              },
              "cvp24": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "host",
        "rate",
        "frames",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "enum": [
            "H1",
            "H2",
            "H3",
            "H4"
          ]
        },
        "rate": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "plugins": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dsp_load_avg": {
          "$ref": "#/$defs/nullableNumber"
        },
        "dsp_load_max": {
          "$ref": "#/$defs/nullableNumber"
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "rss_mb": {
          "$ref": "#/$defs/nullableNumber"
        },
        "add_ms": {
          "$ref": "#/$defs/nullableNumber"
        },
        "recover_ms": {
          "$ref": "#/$defs/nullableNumber"
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "processes": {
          "type": "integer",
          "minimum": 0
        },
        "rss_mb_total": {
          "$ref": "#/$defs/nullableNumber"
        },
        "pss_mb_total": {
          "$ref": "#/$defs/nullableNumber"
        },
        "cpu_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "ctx_switches": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "enum": [
            "ok",
            "unsupported",
            "failed"
          ]
        },
        "note": {
          "type": "string"
        },
        "stress": {
          "type": "string",
          "description": "The load applied while measuring; none for an idle graph."
        },
        "xruns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "repeats": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "jack_clients": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "latency_frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ctx_involuntary": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ctx_jackd": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ctx_jackd_involuntary": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "software": {
          "type": "object",
          "description": "Versions that differ from the run-level software for this row.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "spread": {
          "type": "object",
          "description": "Per measure, [lowest, highest] over the repeats; the figure beside it is the median.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "dsp_load_avg"
            ],
            "properties": {
              "dsp_load_avg": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unsupported",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "note"
            ],
            "properties": {
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "mode": {
      "enum": [
        "individual",
        "chain",
        "chain-add",
        "shared-process"
      ]
    },
    "range": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
