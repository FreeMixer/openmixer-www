node_modules/
.nuxt/
.output/
# `nuxt generate` drops a `dist` SYMLINK to .output/public. A trailing slash
# only matches directories, so it never matched the link and the tree read dirty.
dist
.data/
.env
*.log

# Generated docs pipeline (scripts/gen-*.mjs). Regenerated from an openmixer checkout
# by predev/prebuild/pregenerate — never hand-edit these. openmixer is a PRIVATE repo
# and the Pages workflow carries no credential for it, so unlike a normal build
# output, public/api-docs/, public/openapi.json and the three app/data/*.json below
# ARE committed: an operator regenerates them locally (where the checkout lives) and
# commits the refresh; CI publishes whatever snapshot is checked in. Only the
# intermediate typedoc reflection model stays out of git.
/.docgen-tmp/
